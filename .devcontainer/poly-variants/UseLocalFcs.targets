<Project>
  <!--
    Imported from FsAutoComplete's Directory.Build.targets by build-fsac.sh. Replaces the compile and runtime assets of the
    FSharp.Compiler.Service package (FSharp.Compiler.Service and FSharp.DependencyManager.Nuget) with the assemblies
    in $(LocalFcsDir), keeping the package metadata so the deps.json still lists them under their package.
    FSharp.Core is left alone: the local FCS is built against the shipped FSharp.Core package, which
    FsAutoComplete's own FSharp.Core is at least as new as.
  -->
  <Target Name="UseLocalFcs" AfterTargets="ResolvePackageAssets" Condition="'$(LocalFcsDir)' != ''">
    <ItemGroup>
      <_LocalFcsCompile Include="@(ResolvedCompileFileDefinitions)" Condition="'%(Filename)' == 'FSharp.Compiler.Service' or '%(Filename)' == 'FSharp.DependencyManager.Nuget'" />
      <_LocalFcsCompileReplacement Include="@(_LocalFcsCompile->'$(LocalFcsDir)/%(Filename)%(Extension)')" />
      <_LocalFcsCompileReplacement>
        <HintPath>%(FullPath)</HintPath>
      </_LocalFcsCompileReplacement>
      <ResolvedCompileFileDefinitions Remove="@(_LocalFcsCompile)" />
      <ResolvedCompileFileDefinitions Include="@(_LocalFcsCompileReplacement)" />

      <_LocalFcsRuntime Include="@(RuntimeCopyLocalItems)" Condition="'%(Filename)' == 'FSharp.Compiler.Service' or '%(Filename)' == 'FSharp.DependencyManager.Nuget'" />
      <RuntimeCopyLocalItems Remove="@(_LocalFcsRuntime)" />
      <RuntimeCopyLocalItems Include="@(_LocalFcsRuntime->'$(LocalFcsDir)/%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
</Project>
